# Secrets
.env
.env.*
!.env.example

# Environments and caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/

# Local data, models, indexes (never commit)
data/
models/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.onnx
*.gguf
*.partial
logs/

# Company material must never be added
company/
inbox/

# Model weight side files (data home only)
*.onnx_data

# MCP client project configs: absolute paths and PC values (templates in doc/examples/, design M3 §11.2)
/.mcp.json
/.codex/

# Offline install bundles (built outside the repository by tools/make_bundle.py; never commit wheels or models)
/bundles/
workmcp-bundle-*/
workmcp-model-*/
*.whl

# Token files (the push token lives in the data home, outside the repository; this only stops a stray copy)
push.token
*.token
